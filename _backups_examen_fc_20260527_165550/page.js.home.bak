                      </div>
                      {img.destacado && (
                        <div className="absolute top-3 left-3 bg-[#F47216] text-white text-xs font-bold px-3 py-1 rounded-full shadow-lg">
                          ★ NUEVO
                        </div>
                      )}
                    </div>
                    <div className="p-4">
                      <h3 className="text-slate-900 font-bold mb-0.5">
