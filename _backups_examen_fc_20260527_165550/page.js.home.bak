            <h2 className="text-3xl sm:text-4xl font-black text-slate-900 mb-2 flex items-center justify-center gap-3">
              <Gamepad2 className="w-8 h-8 text-[#F47216]" />
              Juegos
            </h2>
            <p className="text-sm text-slate-600 max-w-xl mx-auto">
