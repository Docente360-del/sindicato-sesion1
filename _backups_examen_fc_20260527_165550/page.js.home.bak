                <div className="flex items-center justify-between">
                  {juego.requiere_clave && (
                    <span className="flex items-center gap-1.5 bg-[#FEF3C7] text-[#92400E] text-xs font-medium px-2.5 py-1 rounded-md">
                      <Lock className="w-3 h-3" /> Clave requerida
                    </span>
                  )}
                  <span className="ml-auto flex items-center gap-1 text-[#F47216] font-bold text-sm group-hover:translate-x-1 transition-transform">
                    Jugar <ArrowRight className="w-4 h-4" />
                  </span>
                </div>
              </button>
            ))}
