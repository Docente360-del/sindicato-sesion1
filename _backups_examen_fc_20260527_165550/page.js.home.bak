                  <div className="absolute top-3 right-3 bg-[#F47216] text-white text-xs font-bold px-3 py-1 rounded-full shadow-md">
                    ★ {juego.badge}
                  </div>
                )}

                <div className="text-5xl mb-3">{juego.emoji}</div>

                <h3 className="text-xl font-black text-[#9A3412] mb-1">
                  {juego.titulo}
                </h3>

                <p className="text-xs font-bold uppercase tracking-wider text-[#D85A0A] mb-3">
                  {juego.subtitulo}
                </p>

                <p className="text-sm text-slate-600 leading-relaxed mb-4">
                  {juego.descripcion}
