// src/data/distractores-brutales.js
// MAPA CURADO A MANO de distractores específicos para cada frase
// Para cada item: 2 distractores que MÁS confunden según la trampa común
// Mezcla 2+1: a veces 2 criterios+1 fin, a veces 2 fines+1 criterio
// Total: 16 items × 2 distractores = 32 trampas precisas

export const DISTRACTORES_BRUTALES = {
  // ═══════════════════════════════════════════════════════════
  // FINES (Art. 15) - distractores que más confunden
  // ═══════════════════════════════════════════════════════════
  "F1": ["C3", "C7"],
  // F1 Desarrollo Humano Integral → confunde con C3 Humanista (ser humano) y C7 Integral (desarrollo integral)

  "F2": ["C7", "F8"],
  // F2 Respeto a la naturaleza → confunde con C7 Integral (formación amplia) y F8 Vida saludable (también es PROMOVER)

  "F3": ["C6", "C1"],
  // F3 Cultura de paz → confunde con C6 Intercultural (convivencia armónica) y C1 Democrático (derechos humanos)

  "F4": ["C4", "C5"],
  // F4 Combatir discriminación → confunde con C4 Equitativo (desigualdades) y C5 Inclusivo (capacidades)

  "F5": ["C7", "C8"],
  // F5 Pensamiento crítico → confunde con C7 Integral (formación) y C8 Excelencia (también menciona pensamiento crítico)

  "F6": ["C8", "F5"],
  // F6 Aprendizaje a lo largo de la vida → confunde con C8 Excelencia (mejora continua) y F5 Pensamiento crítico

  "F7": ["C7", "F5"],
  // F7 Apreciación del arte → confunde con C7 Integral (formación amplia) y F5 Pensamiento crítico (formación)

  "F8": ["C7", "F2"],
  // F8 Estilos de vida saludables → confunde con C7 Integral (formación integral) y F2 Naturaleza (también PROMOVER)

  // ═══════════════════════════════════════════════════════════
  // CRITERIOS (Art. 16) - distractores que más confunden
  // ═══════════════════════════════════════════════════════════
  "C1": ["C2", "F5"],
  // C1 Democrático → confunde con C2 Nacional (sistema social) y F5 Pensamiento crítico (transformación social)

  "C2": ["F4", "C1"],
  // C2 Nacional → confunde con F4 Combatir discriminación (regional/país) y C1 Democrático (sistema social)

  "C3": ["F1", "C7"],
  // C3 Humanista → confunde con F1 Desarrollo humano integral (ser humano) y C7 Integral (desarrollo integral)

  "C4": ["C5", "F4"],
  // C4 Equitativo → confunde con C5 Inclusivo (capacidades) y F4 Combatir discriminación (desigualdades)

  "C5": ["C4", "F4"],
  // C5 Inclusivo → confunde con C4 Equitativo (capacidades) y F4 Combatir discriminación

  "C6": ["F3", "C1"],
  // C6 Intercultural → confunde con F3 Cultura de paz (convivencia) y C1 Democrático (derechos)

  "C7": ["F1", "C3"],
  // C7 Integral → confunde con F1 Desarrollo humano integral (desarrollo integral) y C3 Humanista

  "C8": ["F5", "F6"],
  // C8 Excelencia → confunde con F5 Pensamiento crítico (lo mencionan) y F6 Aprendizaje permanente (mejora)
};
